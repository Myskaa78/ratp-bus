# ==============================================================================
# CONFIGURATION API PRIM (Île-de-France Mobilités)
# ==============================================================================
# Obtenez votre clé API gratuitement sur : https://prim.iledefrance-mobilites.fr
# 1. Créez un compte sur le portail PRIM
# 2. Rendez-vous dans votre profil > "Mes jetons d'authentification"
# 3. Collez votre clé ci-dessous :

IDFM_API_KEY=YOUR_IDFM_API_KEY

# Identifiant technique IDFM (LineRef) pour la ligne 128 de la RATP :
# Pour la ligne 128 RATP, le code référentiel IDFM est C01157.
# Dans le standard SIRI-Lite, le LineRef s'écrit : STIF:Line::C01157:
IDFM_LINE_REF=STIF:Line::C01157:

# Port du serveur backend local
PORT=8000
HOST=0.0.0.0

